{
  "version": "v1",
  "hooks": [
    {
      "name": "Guard test writes",
      "trigger": "PreToolUse",
      "description": "Blocks file writes under tests/ by exiting with code 2.",
      "matcher": "fs_write|fs_append|str_replace|delete_file",
      "action": {
        "type": "command",
        "command": "node .kiro/hooks/guard-tests.js"
      }
    }
  ]
}